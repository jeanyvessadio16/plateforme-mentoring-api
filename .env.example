# ==========================================
# Serveur HTTP & CORS
# ==========================================
PORT=3001
CORS_ORIGIN=https://acceent-mentoring.vercel.app,http://localhost:3000
FRONTEND_URL=https://acceent-mentoring.vercel.app
AUTH_AUTO_CONFIRM=false

# ==========================================
# Supabase Auth & Storage
# ==========================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ==========================================
# Base de données PostgreSQL (Prisma 7)
# ==========================================
# Transaction pooler (exécution applicative)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler / connexion directe (migrations Prisma CLI)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# ==========================================
# Notifications E-mail (Resend principal + SMTP secours)
# ==========================================
RESEND_API_KEY=re_replace_me
MAIL_FROM="ACCEENT Mentoring <onboarding@resend.dev>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
